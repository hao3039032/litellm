# Custom patches on upstream v1.109.0, including the OpenCode session fallback.
FROM ghcr.io/berriai/litellm-database:v1.109.0@sha256:5b645ba56f839a402905fed102b35f1c2dcfb190fd2f0d8cbc0f850ed442a9a4

RUN /app/.venv/bin/python -m ensurepip \
    && /app/.venv/bin/python -m pip install --no-cache-dir socksio==1.0.0 aiohttp-socks==0.12.0

COPY litellm/llms/zai/chat/transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/zai/chat/transformation.py
COPY litellm/llms/opencode/common_utils.py /app/.venv/lib/python3.13/site-packages/litellm/llms/opencode/common_utils.py
COPY litellm/llms/opencode/chat/transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/opencode/chat/transformation.py

COPY litellm/__init__.py /app/.venv/lib/python3.13/site-packages/litellm/__init__.py
COPY litellm/proxy/litellm_pre_call_utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/litellm_pre_call_utils.py

COPY litellm/types/images/main.py /app/.venv/lib/python3.13/site-packages/litellm/types/images/main.py
COPY litellm/llms/openai/image_edit/transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/openai/image_edit/transformation.py
COPY litellm/utils.py /app/.venv/lib/python3.13/site-packages/litellm/utils.py
COPY docker/strip_images.py /app/strip_images.py

COPY litellm/images/main.py /app/.venv/lib/python3.13/site-packages/litellm/images/main.py
COPY litellm/proxy/image_endpoints/endpoints.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/image_endpoints/endpoints.py
COPY litellm/llms/openai/image_generation/gpt_transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/openai/image_generation/gpt_transformation.py
COPY litellm/types/llms/openai.py /app/.venv/lib/python3.13/site-packages/litellm/types/llms/openai.py
COPY litellm/litellm_core_utils/health_check_helpers.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/health_check_helpers.py
COPY litellm/proxy/_lazy_openapi_snapshot.json /app/.venv/lib/python3.13/site-packages/litellm/proxy/_lazy_openapi_snapshot.json

COPY litellm/litellm_core_utils/llm_response_utils/convert_dict_to_response.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/llm_response_utils/convert_dict_to_response.py
COPY litellm/litellm_core_utils/litellm_logging.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/litellm_logging.py
COPY litellm/google_genai/streaming_iterator.py /app/.venv/lib/python3.13/site-packages/litellm/google_genai/streaming_iterator.py
COPY litellm/proxy/pass_through_endpoints/llm_provider_handlers/gemini_passthrough_logging_handler.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/pass_through_endpoints/llm_provider_handlers/gemini_passthrough_logging_handler.py
COPY litellm/proxy/pass_through_endpoints/streaming_handler.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/pass_through_endpoints/streaming_handler.py
COPY litellm/router_utils/pre_call_checks/encrypted_content_affinity_check.py /app/.venv/lib/python3.13/site-packages/litellm/router_utils/pre_call_checks/encrypted_content_affinity_check.py
COPY litellm/responses/utils.py /app/.venv/lib/python3.13/site-packages/litellm/responses/utils.py
COPY litellm/router_rust/invoke/streaming.py /app/.venv/lib/python3.13/site-packages/litellm/router_rust/invoke/streaming.py
COPY litellm/proxy/hooks/responses_id_security.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/hooks/responses_id_security.py

LABEL org.opencontainers.image.title="litellm-database (zai/glm thinking patch)"
LABEL org.opencontainers.image.description="Fork of berriai/litellm v1.109.0 with custom ZAI, client header, image, and Responses API fixes"
LABEL org.opencontainers.image.source="https://github.com/hao3039032/litellm/tree/lw-litellm-staging"
LABEL org.opencontainers.image.base.name="ghcr.io/berriai/litellm-database:v1.109.0"
