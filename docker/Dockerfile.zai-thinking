# Minimal patch image based on upstream v1.94.0 release.
# Applies file patches for zai/glm-5.2 + glm-5v-turbo + reasoning routing + UI registration + client UA forwarding.
# Upstream 1.94.0 already ships a zai provider and most glm model entries; these patches only add what 1.94.0 lacks:
#   1) zai transformation: route thinking/reasoning_effort into extra_body (upstream declares the params but does not inject them)
#   2) backup model cost map: add zai/glm-5.2 + zai/glm-5v-turbo (upstream backup map lacks both)
#   3) force local backup usage (1.94.0 fetches the root map remotely by default; that copy lacks zai/glm-5.2)
#   4) provider_create_fields.json: register ZAI in Add Model UI dropdown + credential fields
#   5) forward inbound client User-Agent to upstream provider when LITELLM_FORWARD_CLIENT_USER_AGENT is set
FROM ghcr.io/berriai/litellm-database:v1.94.0

# Patch 1: zai provider transformation (reasoning -> extra_body routing)
COPY litellm/llms/zai/chat/transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/zai/chat/transformation.py

# Patch 2: backup model cost map (includes zai/glm-5.2 + zai/glm-5v-turbo)
COPY litellm/model_prices_and_context_window_backup.json /app/.venv/lib/python3.13/site-packages/litellm/model_prices_and_context_window_backup.json

# Patch 3: register ZAI provider in the Add Model UI dropdown + credential fields
COPY litellm/proxy/public_endpoints/provider_create_fields.json /app/.venv/lib/python3.13/site-packages/litellm/proxy/public_endpoints/provider_create_fields.json

# Patch 4: forward inbound client User-Agent upstream (LITELLM_FORWARD_CLIENT_USER_AGENT)
COPY litellm/__init__.py /app/.venv/lib/python3.13/site-packages/litellm/__init__.py
COPY litellm/proxy/litellm_pre_call_utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/litellm_pre_call_utils.py

# Force litellm to use local backup (skip upstream raw fetch which lacks zai/glm-5.2)
ENV LITELLM_LOCAL_MODEL_COST_MAP=true

LABEL org.opencontainers.image.title="litellm-database (zai/glm-5.2 thinking patch)"
LABEL org.opencontainers.image.description="Fork of berriai/litellm v1.94.0 with reasoning extra_body routing + zai/glm-5.2 + zai/glm-5v-turbo + backup file + ZAI UI registration + client UA forwarding"
LABEL org.opencontainers.image.source="https://github.com/hao3039032/litellm/tree/litellm_forward_client_user_agent"
LABEL org.opencontainers.image.base.name="ghcr.io/berriai/litellm-database:v1.94.0"
